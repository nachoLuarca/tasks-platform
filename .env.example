# Copiar este archivo a .env y ajustar los valores segun el entorno.
# Todas las variables sin valor por defecto son obligatorias: si falta alguna,
# la API falla al arrancar indicando cual es.
#
# ---------------------------------------------------------------------------
# COMO LEER ESTE ARCHIVO
#
# Este archivo sirve a dos entornos distintos, y cada bloque esta marcado con
# uno de estos tres prefijos:
#
#   [LOCAL]  Solo tiene sentido en desarrollo con Docker Compose. En Render no
#            se carga: o no aplica (Postgres y Redis los ponen Neon y Upstash)
#            o el valor por defecto del codigo ya es el correcto.
#   [AMBOS]  Se usa en local y en produccion, con valores distintos. En Render
#            se carga en el panel; aca queda el valor de desarrollo.
#   [RENDER] El valor de produccion no puede estar en el repositorio. Lo pega
#            el usuario en el panel de Render, o lo genera Render solo. Ver
#            `render.yaml`, que declara exactamente cuales son.
#
# Ningun valor de este archivo es un secreto real: son los de desarrollo local.
# Los de produccion nunca se escriben aca.
# ---------------------------------------------------------------------------

# --- Aplicacion --- [AMBOS]
# En Render: NODE_ENV=production, PORT=3000 y LOG_LEVEL=info los fija
# render.yaml solo; CORS_ORIGIN se completa a mano con el dominio del front.
# BODY_LIMIT y SHUTDOWN_TIMEOUT_MS se quedan con su valor por defecto.
# development | test | production
NODE_ENV=development
# Puerto en el que escucha la API
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Origen permitido para CORS. "*" solo es valido en development.
CORS_ORIGIN=http://localhost:5173
# Limite de tamano del body aceptado (formato de la libreria "bytes", ej. 1mb)
BODY_LIMIT=1mb
# Milisegundos maximos de gracia para el apagado ordenado ante SIGTERM
SHUTDOWN_TIMEOUT_MS=10000

# --- Base de datos --- [LOCAL + RENDER]
# POSTGRES_USER/PASSWORD/DB son [LOCAL]: solo las lee docker-compose para
# crear el contenedor de Postgres. En Render no existen.
# DATABASE_URL es [RENDER]: en produccion es la cadena de Neon, pegada a mano
# en el grupo de variables `tasks-platform-shared` (ver render.yaml).
# Usadas por docker-compose para crear el contenedor de Postgres
POSTGRES_USER=tasks_platform
POSTGRES_PASSWORD=tasks_platform
POSTGRES_DB=tasks_platform
# Cadena de conexion que usa Prisma. Al correr fuera de Docker usa "localhost";
# docker-compose la sobreescribe con el hostname del servicio "db".
DATABASE_URL=postgresql://tasks_platform:tasks_platform@localhost:5432/tasks_platform?schema=public

# --- Redis --- [RENDER]
# En produccion es la URL de Upstash, con esquema `rediss://` (TLS obligatorio).
# docker-compose la sobreescribe con el hostname del servicio "redis"
REDIS_URL=redis://localhost:6379

# --- Auth --- [RENDER]
# JWT_SECRET lo genera Render solo (`generateValue: true`): nunca se pega a
# mano ni se copia de aca. COOKIE_SAME_SITE pasa a `none` en produccion,
# porque el front vive en otro dominio que la API.
# Secreto para firmar los access tokens (HS256). Minimo 32 caracteres.
# El valor de abajo es solo para desarrollo/tests: generar uno propio para
# cualquier entorno real, por ejemplo con `openssl rand -base64 48`.
JWT_SECRET=dev-only-secret-change-me-please-1234567890
# lax | strict | none. La cookie del refresh token siempre es httpOnly, y
# ademas "secure" cuando NODE_ENV=production.
COOKIE_SAME_SITE=lax

# Costo de Argon2id para el hash de contraseñas. Los valores por defecto
# siguen el minimo recomendado por OWASP; bajarlos solo para acelerar tests.
ARGON2_MEMORY_COST_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# --- Limite de intentos (register, login, refresh) --- [LOCAL]
# Los valores por defecto del codigo son los mismos: en Render no se declaran.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_ATTEMPTS=10

# --- Compartidas por api y worker --- [RENDER]
# En produccion, APP_PUBLIC_URL es la URL que Render asigna al servicio api
# (https://<nombre>.onrender.com), y WEB_APP_URL la del front de la Fase 7.
# URL publica en la que responde la API. Se usa para construir enlaces dentro
# de los correos (por ejemplo, el de invitacion), ya que un job en segundo
# plano no tiene un "req" del que leer protocolo/host como si fuera un
# handler HTTP.
APP_PUBLIC_URL=http://localhost:3000
# URL publica del cliente web. Los enlaces de verificacion de correo y de
# recuperacion de contrasena apuntan aca (no a la API), con el token en el
# fragmento (#token=...), que el navegador nunca envia a ningun servidor.
WEB_APP_URL=http://localhost:5173

# --- Correos de cuenta (solo api) --- [LOCAL]
# Mismo valor por defecto en el codigo: en Render no se declara.
# Maximo de correos de verificacion por cuenta en la ultima hora, incluido el
# del registro. No se desactiva con RATE_LIMIT_ENABLED.
EMAIL_VERIFICATION_MAX_PER_HOUR=3

# --- SMTP --- [RENDER]
# En desarrollo apunta a Mailpit, que no pide autenticacion. En produccion son
# las credenciales de un proveedor SMTP real (Resend, Brevo, Mailgun, ...),
# pegadas a mano en el panel: Mailpit no existe en Render.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=Tasks Platform <no-reply@tasks-platform.dev>
# SMTP_USER y SMTP_PASSWORD quedan sin valor: Mailpit no requiere autenticacion.

# --- Webhooks salientes --- [LOCAL]
# Mismos valores por defecto en el codigo: en Render no se declaran.
# Milisegundos maximos de espera por una respuesta del receptor antes de dar
# el intento por fallido.
WEBHOOK_DELIVERY_TIMEOUT_MS=10000
# Fallos de entrega consecutivos tras los cuales un endpoint se desactiva solo.
WEBHOOK_MAX_CONSECUTIVE_FAILURES=20
# Tolerancia, en segundos, entre la marca de tiempo firmada y el reloj del
# receptor al verificar una firma.
WEBHOOK_SIGNATURE_TOLERANCE_SECONDS=300

# --- Worker --- [LOCAL + RENDER]
# WORKER_PORT lo fija render.yaml en el servicio worker.
# PASSWORD_RESET_MAX_PER_HOUR se queda con su valor por defecto.
# Puerto del endpoint de salud propio del proceso worker.
WORKER_PORT=3100
# Maximo de correos de recuperacion de contrasena por cuenta en la ultima
# hora. Pasado el limite, la solicitud se descarta en silencio (la API ya
# respondio 202 igual que siempre), para no revelar si el correo existe.
PASSWORD_RESET_MAX_PER_HOUR=3
