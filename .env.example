# Copiar este archivo a .env y ajustar los valores segun el entorno.
# Todas las variables sin valor por defecto son obligatorias: si falta alguna,
# la API falla al arrancar indicando cual es.

# --- Aplicacion ---
# development | test | production
NODE_ENV=development
# Puerto en el que escucha la API
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Origen permitido para CORS. "*" solo es valido en development.
CORS_ORIGIN=http://localhost:5173
# Limite de tamano del body aceptado (formato de la libreria "bytes", ej. 1mb)
BODY_LIMIT=1mb
# Milisegundos maximos de gracia para el apagado ordenado ante SIGTERM
SHUTDOWN_TIMEOUT_MS=10000

# --- Base de datos ---
# Usadas por docker-compose para crear el contenedor de Postgres
POSTGRES_USER=tasks_platform
POSTGRES_PASSWORD=tasks_platform
POSTGRES_DB=tasks_platform
# Cadena de conexion que usa Prisma. Al correr fuera de Docker usa "localhost";
# docker-compose la sobreescribe con el hostname del servicio "db".
DATABASE_URL=postgresql://tasks_platform:tasks_platform@localhost:5432/tasks_platform?schema=public

# --- Redis ---
# docker-compose la sobreescribe con el hostname del servicio "redis"
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Secreto para firmar los access tokens (HS256). Minimo 32 caracteres.
# El valor de abajo es solo para desarrollo/tests: generar uno propio para
# cualquier entorno real, por ejemplo con `openssl rand -base64 48`.
JWT_SECRET=dev-only-secret-change-me-please-1234567890
# lax | strict | none. La cookie del refresh token siempre es httpOnly, y
# ademas "secure" cuando NODE_ENV=production.
COOKIE_SAME_SITE=lax

# Costo de Argon2id para el hash de contraseñas. Los valores por defecto
# siguen el minimo recomendado por OWASP; bajarlos solo para acelerar tests.
ARGON2_MEMORY_COST_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# --- Limite de intentos (register, login, refresh) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_ATTEMPTS=10

# --- Compartidas por api y worker ---
# URL publica en la que responde la API. Se usa para construir enlaces dentro
# de los correos (por ejemplo, el de invitacion), ya que un job en segundo
# plano no tiene un "req" del que leer protocolo/host como si fuera un
# handler HTTP.
APP_PUBLIC_URL=http://localhost:3000
# URL publica del cliente web. Los enlaces de verificacion de correo y de
# recuperacion de contrasena apuntan aca (no a la API), con el token en el
# fragmento (#token=...), que el navegador nunca envia a ningun servidor.
WEB_APP_URL=http://localhost:5173

# --- Correos de cuenta (solo api) ---
# Maximo de correos de verificacion por cuenta en la ultima hora, incluido el
# del registro. No se desactiva con RATE_LIMIT_ENABLED.
EMAIL_VERIFICATION_MAX_PER_HOUR=3

# --- SMTP (Mailpit en desarrollo) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=Tasks Platform <no-reply@tasks-platform.dev>
# SMTP_USER y SMTP_PASSWORD quedan sin valor: Mailpit no requiere autenticacion.

# --- Webhooks salientes ---
# Milisegundos maximos de espera por una respuesta del receptor antes de dar
# el intento por fallido.
WEBHOOK_DELIVERY_TIMEOUT_MS=10000
# Fallos de entrega consecutivos tras los cuales un endpoint se desactiva solo.
WEBHOOK_MAX_CONSECUTIVE_FAILURES=20
# Tolerancia, en segundos, entre la marca de tiempo firmada y el reloj del
# receptor al verificar una firma.
WEBHOOK_SIGNATURE_TOLERANCE_SECONDS=300

# --- Worker ---
# Puerto del endpoint de salud propio del proceso worker.
WORKER_PORT=3100
