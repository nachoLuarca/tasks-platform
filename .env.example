# Copiar este archivo a .env y ajustar los valores segun el entorno.
# Todas las variables sin valor por defecto son obligatorias: si falta alguna,
# la API falla al arrancar indicando cual es.

# --- Aplicacion ---
# development | test | production
NODE_ENV=development
# Puerto en el que escucha la API
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Origen permitido para CORS. "*" solo es valido en development.
CORS_ORIGIN=http://localhost:5173
# Limite de tamano del body aceptado (formato de la libreria "bytes", ej. 1mb)
BODY_LIMIT=1mb
# Milisegundos maximos de gracia para el apagado ordenado ante SIGTERM
SHUTDOWN_TIMEOUT_MS=10000

# --- Base de datos ---
# Usadas por docker-compose para crear el contenedor de Postgres
POSTGRES_USER=tasks_platform
POSTGRES_PASSWORD=tasks_platform
POSTGRES_DB=tasks_platform
# Cadena de conexion que usa Prisma. Al correr fuera de Docker usa "localhost";
# docker-compose la sobreescribe con el hostname del servicio "db".
DATABASE_URL=postgresql://tasks_platform:tasks_platform@localhost:5432/tasks_platform?schema=public

# --- Redis ---
# docker-compose la sobreescribe con el hostname del servicio "redis"
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Secreto para firmar los access tokens (HS256). Minimo 32 caracteres.
# El valor de abajo es solo para desarrollo/tests: generar uno propio para
# cualquier entorno real, por ejemplo con `openssl rand -base64 48`.
JWT_SECRET=dev-only-secret-change-me-please-1234567890
# lax | strict | none. La cookie del refresh token siempre es httpOnly, y
# ademas "secure" cuando NODE_ENV=production.
COOKIE_SAME_SITE=lax

# Costo de Argon2id para el hash de contraseñas. Los valores por defecto
# siguen el minimo recomendado por OWASP; bajarlos solo para acelerar tests.
ARGON2_MEMORY_COST_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# --- Limite de intentos (register, login, refresh) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_ATTEMPTS=10
