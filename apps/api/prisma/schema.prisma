// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String
  name            String
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  memberships          Membership[]
  refreshTokens        RefreshToken[]
  invitationsSent      Invitation[]
  projectsCreated      Project[]
  tasksCreated         Task[]            @relation("TaskCreator")
  tasksAssigned        Task[]            @relation("TaskAssignee")
  comments             Comment[]
  taskActivities       TaskActivity[]
  webhookEndpoints     WebhookEndpoint[]
  apiKeys              ApiKey[]
}

model Organization {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  memberships      Membership[]
  invitations      Invitation[]
  projects         Project[]
  labels           Label[]
  outboxEvents     OutboxEvent[]
  webhookEndpoints WebhookEndpoint[]
  apiKeys          ApiKey[]
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Membership {
  id             String   @id @default(uuid())
  userId         String
  organizationId String
  role           Role     @default(MEMBER)
  joinedAt       DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([userId, organizationId])
  @@index([organizationId])
}

// The token itself is never stored, only its SHA-256 hash (same pattern as
// RefreshToken). "Pending" means acceptedAt IS NULL AND revokedAt IS NULL.
// Prisma's schema language has no partial-index syntax, so the unique index
// that enforces "at most one pending invitation per (organizationId, email)"
// is added by hand in the migration SQL and isn't representable here -- see
// migration 20260907000000_add_roles_and_invitations.
model Invitation {
  id             String    @id @default(uuid())
  organizationId String
  email          String
  role           Role
  tokenHash      String    @unique
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  invitedBy    User         @relation(fields: [invitedById], references: [id])

  @@index([organizationId, email])
}

// Rotation chain: each use of a token revokes it and issues a new one in the
// same family (replacedById -> the token that replaced this one). Presenting
// an already-revoked token means it was stolen: the whole family gets
// revoked. See docs/adr/0003-refresh-token-rotation.md.
model RefreshToken {
  id           String    @id @default(uuid())
  userId       String
  tokenHash    String    @unique
  familyId     String
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @unique
  createdAt    DateTime  @default(now())
  userAgent    String?
  ipAddress    String?

  user         User          @relation(fields: [userId], references: [id])
  replacedBy   RefreshToken? @relation("TokenChain", fields: [replacedById], references: [id])
  replacedFrom RefreshToken? @relation("TokenChain")

  @@index([familyId])
  @@index([userId])
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// "key" (e.g. "ENG") is unique per organization, not globally: two different
// organizations can each have their own "ENG" project. taskCounter is
// incremented and read inside the same transaction that creates a task (see
// tasks.repository.ts), so it doubles as "the last number handed out" -- it
// is never decremented, so numbers are never reused after a delete.
model Project {
  id             String        @id @default(uuid())
  organizationId String
  key            String
  name           String
  description    String?
  status         ProjectStatus @default(ACTIVE)
  taskCounter    Int           @default(0)
  createdById    String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  createdBy    User         @relation(fields: [createdById], references: [id])
  tasks        Task[]

  @@unique([organizationId, key])
}

// "version" implements optimistic locking: every update must include the
// version it read, and the update only succeeds if it still matches the row
// in the database (see docs/adr/0007-optimistic-locking.md).
model Task {
  id          String       @id @default(uuid())
  projectId   String
  number      Int
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  assigneeId  String?
  createdById String
  dueDate     DateTime?
  completedAt DateTime?
  version     Int          @default(1)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  project    Project        @relation(fields: [projectId], references: [id])
  assignee   User?          @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdBy  User           @relation("TaskCreator", fields: [createdById], references: [id])
  comments   Comment[]
  taskLabels TaskLabel[]
  activities TaskActivity[]

  @@unique([projectId, number])
  @@index([projectId, status])
  @@index([assigneeId])
  @@index([dueDate])
}

// Soft-deleted so a removed comment disappears from the thread while its
// TaskActivity "commented" entry (which never references the Comment row)
// stays in the log, per PHASE.md decision 9.
model Comment {
  id        String    @id @default(uuid())
  taskId    String
  authorId  String
  body      String
  editedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  task   Task @relation(fields: [taskId], references: [id])
  author User @relation(fields: [authorId], references: [id])

  @@index([taskId, createdAt])
}

// Belongs to the organization, not the project, so the same label is
// reusable across every project in it (PHASE.md decision 3). Uniqueness is
// case-insensitive, which Prisma's schema language can't express as a plain
// `@@unique` (that would be case-sensitive) -- the actual constraint is a
// functional unique index on (organizationId, LOWER(name)), hand-written in
// the migration SQL, same approach as Invitation's partial unique index.
// There's no `deletedAt`: PHASE.md's data model for Label lists no soft
// delete, and "deleting" a label only needs to drop its TaskLabel rows
// without deleting the tasks it was attached to -- a hard delete of the
// Label row (cascading only the join rows) already does that.
model Label {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  color          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  taskLabels   TaskLabel[]

  @@index([organizationId])
}

model TaskLabel {
  taskId    String
  labelId   String
  createdAt DateTime @default(now())

  task  Task  @relation(fields: [taskId], references: [id])
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@index([labelId])
}

// One row per change PHASE.md asks to track: task creation, and a change to
// status / priority / assignee / due date / title / labels, or a new
// comment. `type` names the *kind* of change (mirrors an eventual webhook
// event name -- see docs/adr/0008-activity-log.md); `changes` is always
// `{ before, after }` for that one field, never a bag of every field on the
// task. Written inside the same transaction as the change it describes (see
// activity.service.ts) so a rolled-back operation leaves no entry.
enum TaskActivityType {
  TASK_CREATED
  STATUS_CHANGED
  PRIORITY_CHANGED
  ASSIGNEE_CHANGED
  DUE_DATE_CHANGED
  TITLE_CHANGED
  LABELS_CHANGED
  COMMENT_ADDED
}

// `actorId` (a User) and `apiKeyActorId` (an ApiKey) are mutually exclusive:
// an entry is caused by exactly one of a human, authenticated with a JWT, or
// a machine, authenticated with an API key -- never both, never neither
// (PHASE.md decision 9, Phase 4). Both columns are nullable because Prisma's
// schema language has no CHECK constraint syntax; the actual constraint is
// hand-written in the migration SQL, same approach as every other
// not-representable constraint so far (Invitation's partial unique index,
// Label's functional unique index). Every entry that predates this phase has
// `actorId` set (they were all written before API keys existed), so the
// migration backfills nothing -- both new columns just start out nullable
// with the existing data already satisfying the constraint.
model TaskActivity {
  id            String           @id @default(uuid())
  taskId        String
  actorId       String?
  apiKeyActorId String?
  type          TaskActivityType
  changes       Json
  createdAt     DateTime         @default(now())

  task        Task    @relation(fields: [taskId], references: [id])
  actor       User?   @relation(fields: [actorId], references: [id])
  apiKeyActor ApiKey? @relation(fields: [apiKeyActorId], references: [id])

  @@index([taskId, createdAt])
}

// One row per domain change that should be publishable as an outbound
// webhook event, written in the SAME transaction as the TaskActivity entry
// it mirrors (see activity.service.ts and docs/adr/0009-outbox-pattern.md).
// `type` matches a TaskActivityType name; `payload` is already the shape
// that goes out over the wire to a subscriber. `dispatchedAt` is set by the
// worker's dispatcher once it has claimed the row and hands it to the queue
// -- it is not "delivered", just "handed off", so `attempts` here counts
// dispatch attempts, not per-webhook delivery attempts (see WebhookDelivery
// for those).
model OutboxEvent {
  id             String    @id @default(uuid())
  organizationId String
  type           String
  payload        Json
  createdAt      DateTime  @default(now())
  dispatchedAt   DateTime?
  attempts       Int       @default(0)

  organization Organization      @relation(fields: [organizationId], references: [id])
  deliveries   WebhookDelivery[]

  @@index([dispatchedAt, createdAt])
}

// `eventTypes` is the subscription list: which OutboxEvent.type values this
// endpoint wants. `secret` is returned to the caller only at creation and at
// rotation time (see webhooks.service.ts) -- every other read of this row
// (list, get) must map it away before it reaches a response.
// `consecutiveFailures` is reset to 0 by any successful delivery and
// increments once per delivery that exhausts all of its retry attempts
// (PHASE.md decision 5); at WEBHOOK_MAX_CONSECUTIVE_FAILURES (20 by
// default) the endpoint disables itself and records why.
model WebhookEndpoint {
  id                  String    @id @default(uuid())
  organizationId      String
  url                 String
  secret              String
  eventTypes          String[]
  enabled             Boolean   @default(true)
  disabledReason      String?
  consecutiveFailures Int       @default(0)
  createdById         String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id])
  createdBy    User              @relation(fields: [createdById], references: [id])
  deliveries   WebhookDelivery[]

  @@index([organizationId])
}

// One row per delivery attempt (not per event): a 5-attempt retry chain for
// the same OutboxEvent to the same endpoint produces up to 5 rows, one per
// `attempt` number, so a developer debugging an integration can see exactly
// what each attempt returned. `responseSnippet` is deliberately truncated by
// the writer (see webhook-delivery.processor.ts) -- this column is for
// debugging, not for storing an unbounded response body.
model WebhookDelivery {
  id              String    @id @default(uuid())
  endpointId      String
  outboxEventId   String
  attempt         Int
  statusCode      Int?
  responseSnippet String?
  error           String?
  durationMs      Int
  createdAt       DateTime  @default(now())

  endpoint    WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  outboxEvent OutboxEvent     @relation(fields: [outboxEventId], references: [id])

  @@index([endpointId, createdAt])
}

// `prefix` (visible, e.g. "tp_live_ab12cd34") identifies the key in a
// listing without revealing it; `keyHash` is the SHA-256 of the full key
// (prefix + random part), same hashing primitive as refresh/invitation
// tokens (see shared/security/tokens.ts hashToken). The full key is shown to
// the caller exactly once, at creation (api-keys.service.ts never returns
// it again). `scopes` are Permission strings, checked against the same
// matrix vocabulary as roles but resolved independently of any role -- see
// shared/authorization/api-key-scopes.ts for why this phase only allows a
// read-only subset.
model ApiKey {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  prefix         String
  keyHash        String    @unique
  scopes         String[]
  createdById    String
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization   Organization   @relation(fields: [organizationId], references: [id])
  createdBy      User           @relation(fields: [createdById], references: [id])
  taskActivities TaskActivity[]

  @@index([organizationId])
}
